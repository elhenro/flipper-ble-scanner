App(
    appid="ble_scanner",
    name="BLE Scanner",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="ble_scanner_main",
    requires=["gui", "storage"],
    stack_size=3 * 1024,
    fap_category="Bluetooth",
    fap_icon="icon.png",
    fap_version="0.2",
    fap_description="Scan nearby BLE devices, estimate their distance, and explore their data. Patches Momentum and uses the Flipper's full radio stack so it can actually scan.",
)
