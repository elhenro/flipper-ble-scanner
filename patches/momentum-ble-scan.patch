+++ b/targets/f7/furi_hal/furi_hal_bt.c
@@ -267,6 +267,39 @@ void furi_hal_bt_stop_advertising(void) {
     }
 }
 
+uint8_t furi_hal_bt_start_scan(uint16_t interval, uint16_t window, bool active) {
+    // light stack is peripheral only, gap observer role exists only on full stack
+    if(furi_hal_bt.stack != FuriHalBtStackFull) return BLE_STATUS_FAILED;
+    // active sends scan requests so peers answer with scan response (names live there)
+    // public own address, no duplicate filter (keeps rssi updates), accept all
+    return aci_gap_start_observation_proc(interval, window, active, 0, 0, 0);
+}
+
+void furi_hal_bt_stop_scan(void) {
+    if(furi_hal_bt.stack == FuriHalBtStackFull) aci_gap_terminate_gap_proc(GAP_OBSERVATION_PROC);
+}
+
+uint8_t furi_hal_bt_hci_command(
+    uint16_t opcode,
+    const void* params,
+    uint8_t params_len,
+    void* resp,
+    uint8_t resp_len) {
+    uint8_t status = BLE_STATUS_FAILED;
+    // hci_send_req handles both command status (status byte) and complete (return params)
+    struct hci_request rq = {
+        .ogf = opcode >> 10,
+        .ocf = opcode & 0x3FF,
+        .cparam = (void*)params,
+        .clen = params_len,
+        .rparam = resp_len ? resp : &status,
+        .rlen = resp_len ? resp_len : 1,
+    };
+    // never fails: a missing response trips furi_check in hci_cmd_resp_wait
+    hci_send_req(&rq, false);
+    return resp_len ? *(uint8_t*)resp : status;
+}
+
 void furi_hal_bt_update_battery_level(uint8_t battery_level) {
     ble_svc_battery_state_update(&battery_level, NULL);
 }
